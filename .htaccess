RewriteEngine On

# Ensure HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================
# PERFORMANCE & COMPRESSION OPTIMIZATIONS (Hostinger LiteSpeed/Apache)
# ============================================================

# Enable GZIP/Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff
</IfModule>

# Cache-Control & Expires Headers — 1 Year Immutable for all static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Static media: 1-year immutable cache
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg|mp4|webm|woff2|woff)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # JS/CSS bundles: 1-year immutable (Next.js hashes filenames)
    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Remove no-cache headers that may be set by upstream
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg|mp4|webm|woff2|woff|css|js)$">
        Header unset Pragma
        Header unset Expires
    </FilesMatch>
</IfModule>
